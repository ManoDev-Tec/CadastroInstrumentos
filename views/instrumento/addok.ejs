<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro realizado</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h1>Instrumento cadastrado com sucesso!</h1>

    <h2>Dados cadastrados:</h2>

    <p>
        <strong>Nome:</strong>
        <%= instrumento.nome %>
    </p>

    <p>
        <strong>Fabricante:</strong>
        <%= instrumento.fabricante %>
    </p>

    <p>
        <strong>Preço:</strong>
        R$ <%= Number(instrumento.preco).toFixed(2) %>
    </p>

    <p>
        <strong>Tipo:</strong>
        <%= instrumento.tipo %>
    </p>

    <br>

    <a href="/instrumentos/novo">Cadastrar outro instrumento</a>

    <br><br>

    <a href="/instrumentos">Consultar listagem</a>

    <br><br>

    <a href="/">Página inicial</a>

</body>

</html>